<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WeldScopeOpenCvArch>$(Platform)</WeldScopeOpenCvArch>
    <WeldScopeOpenCvArch Condition="'$(Platform)' == 'Win32'">x86</WeldScopeOpenCvArch>
    <WeldScopeOpenCvSuffix Condition="'$(Configuration)' == 'Debug'">d</WeldScopeOpenCvSuffix>
    <WeldScopeOpenCvInstallSuffix Condition="'$(Configuration)' == 'Debug'">-debug</WeldScopeOpenCvInstallSuffix>
    <WeldScopeOpenCvRoot Condition="'$(WeldScopeOpenCvRoot)' == '' and '$(Platform)' == 'ARM64'">$(MSBuildThisFileDirectory)..\..\.tools\opencv\install-arm64$(WeldScopeOpenCvInstallSuffix)</WeldScopeOpenCvRoot>
    <WeldScopeOpenCvRoot Condition="'$(WeldScopeOpenCvRoot)' == '' and '$(Platform)' == 'x64'">$(MSBuildThisFileDirectory)..\..\.tools\opencv\install-x64$(WeldScopeOpenCvInstallSuffix)</WeldScopeOpenCvRoot>
    <WeldScopeOpenCvLibDir>$(WeldScopeOpenCvRoot)\$(WeldScopeOpenCvArch)\vc18\staticlib</WeldScopeOpenCvLibDir>
    <WeldScopeOpenCvHal Condition="'$(Platform)' == 'ARM64'">tegra_hal.lib;</WeldScopeOpenCvHal>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\WeldScope.FileInspection;$(WeldScopeOpenCvRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(WeldScopeOpenCvLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opencv_imgcodecs4130$(WeldScopeOpenCvSuffix).lib;opencv_imgproc4130$(WeldScopeOpenCvSuffix).lib;opencv_core4130$(WeldScopeOpenCvSuffix).lib;$(WeldScopeOpenCvHal)libpng$(WeldScopeOpenCvSuffix).lib;zlib$(WeldScopeOpenCvSuffix).lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="RequireWeldScopeOpenCv" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WeldScopeOpenCvRoot)' == '' or !Exists('$(WeldScopeOpenCvLibDir)\opencv_imgcodecs4130$(WeldScopeOpenCvSuffix).lib')"
           Text="WeldScope needs the matching OpenCV 4.13.0 static install for $(Platform)|$(Configuration). Run tools/setup-opencv-s04.ps1 -Platform $(Platform) -Configuration $(Configuration) for ARM64 or x64." />
  </Target>
  <Target Name="CopyWeldScopeModel" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\config\pooled-smooth-220.json;$(MSBuildThisFileDirectory)..\..\config\model-220.txt" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
